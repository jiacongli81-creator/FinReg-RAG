APP_NAME=Financial Regulation RAG API
DATABASE_PATH=data/app.db
DATABASE_BACKEND=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finreg_rag
# MYSQL_CREDENTIALS defaults to mineru_runtime/mysql/credentials.json
RAW_DATA_DIR=data/raw
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
# RERANK_CACHE_DIR defaults to mineru_runtime/reranker

# Ollama local semantic retrieval
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=shaw/dmeta-embedding-zh:latest
EMBEDDING_TIMEOUT_SECONDS=120

# mock: local extractive fallback; openai_compatible: any OpenAI-compatible endpoint
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Local MinerU; leave paths unset to use paths relative to the project root
MINERU_ENABLED=true
MINERU_TIMEOUT_SECONDS=1800

# Future production adapters
MYSQL_URL=
MILVUS_URI=
