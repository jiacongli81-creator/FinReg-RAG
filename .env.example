APP_NAME=Financial Regulation RAG API
DATABASE_PATH=data/app.db
DATABASE_BACKEND=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finreg_rag
# MYSQL_CREDENTIALS defaults to mineru_runtime/mysql/credentials.json
# Docker can instead provide MYSQL_USER and MYSQL_PASSWORD as environment variables.
VECTOR_BACKEND=local
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=financial_chunks
RAW_DATA_DIR=data/raw
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATE_N=20
RETRIEVAL_FAST_TOP_K=5
RETRIEVAL_FAST_CANDIDATE_N=5
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
RERANK_BATCH_SIZE=16
# RERANK_CACHE_DIR defaults to mineru_runtime/reranker

# Ollama local semantic retrieval
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=shaw/dmeta-embedding-zh:latest
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_KEEP_ALIVE=1h

# Smart mode: mock is a local fallback; openai_compatible uses an external model
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120

# Local MinerU; leave paths unset to use paths relative to the project root
MINERU_ENABLED=true
MINERU_TIMEOUT_SECONDS=1800
